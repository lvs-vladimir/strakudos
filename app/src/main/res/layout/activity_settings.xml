<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FC5200"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="НАСТРОЙКИ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Скорость лайков в клубах -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="СКОРОСТЬ ЛАЙКОВ В КЛУБАХ"
                android:textColor="#00F0FF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/radioClubsSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111111"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/radioSlow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Медленно (2-5 сек)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/radioMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Средне (1-2.5 сек)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/radioFast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Быстро (0.5-1.2 сек)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/radioUltra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Очень быстро (0.3-0.5 сек)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:paddingVertical="8dp" />
            </RadioGroup>

            <!-- Лимит подряд уже-лайкнутых для перехода к следующему клубу -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ЛИМИТ УЖЕ ЛАЙКНУТЫХ (переход к след. клубу)"
                android:textColor="#00F0FF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#111111"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Подряд уже лайкнуто:"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etConsecutiveLimit"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:text="10"
                    android:textColor="#00F0FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#222222"
                    android:textCursorDrawable="@null"
                    android:padding="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Если подряд N тренировок уже лайкнуты — бот перейдет к следующему клубу"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

        <!-- Автозапуск -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="АВТОЗАПУСК"
            android:textColor="#00F0FF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#111111"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Открывать приложение после запуска Android"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchAutostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumbTint="#00F0FF"
                android:trackTint="#333333" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Для Android x86: после загрузки системы Strakudos откроется автоматически. Если бот был запущен до перезагрузки, он продолжит после загрузки Strava."
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnResetCounter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_secondary_bg"
                android:text="Сбросить счетчик лайков"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="32dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
