<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FC5200"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="СТРАТЕГИЯ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ВЫБЕРИТЕ СТРАТЕГИЮ"
                android:textColor="#00F0FF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <RadioGroup
                android:id="@+id/radioStrategies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioSmart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="УМНАЯ (рекомендуется)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:padding="12dp"
                    android:checked="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Сканирует ленту, скроллит вниз, возвращается вверх для новых тренировок, обновляет страницу"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="40dp"
                    android:layout_marginBottom="16dp" />

                <RadioButton
                    android:id="@+id/radioTopOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ТОЛЬКО НОВЫЕ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Лайкает только верхние тренировки без глубокого скролла. Быстро и безопасно."
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="40dp"
                    android:layout_marginBottom="16dp" />

                <RadioButton
                    android:id="@+id/radioAggressive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="АГРЕССИВНАЯ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Максимальная скорость. Минимальные задержки. Риск блокировки!"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="40dp"
                    android:layout_marginBottom="16dp" />

                <RadioButton
                    android:id="@+id/radioHuman"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ЧЕЛОВЕЧНАЯ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Большие случайные паузы, медленный скролл. Максимально естественно."
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="40dp"
                    android:layout_marginBottom="16dp" />

                <RadioButton
                    android:id="@+id/radioClubs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="КЛУБЫ (РОТАЦИЯ)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#00F0FF"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Автоматически переключается между вашей лентой и лентами клубов, в которые вы входите. Лайкает везде."
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="40dp"
                    android:layout_marginBottom="16dp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ИНТЕРВАЛ ЗАДЕРЖКИ (МС)"
                android:textColor="#00F0FF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="МИН:"
                    android:textColor="#88FFFFFF"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etMinDelay"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:background="@drawable/card_glass_bg"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="5000"
                    android:textColor="#00F0FF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="24dp"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="МАКС:"
                    android:textColor="#88FFFFFF"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etMaxDelay"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:background="@drawable/card_glass_bg"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="12000"
                    android:textColor="#00F0FF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:padding="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Меньше значение = быстрее (риск блокировки)\nБольше значение = безопаснее"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:layout_marginBottom="16dp"
                android:lineSpacingMultiplier="1.3" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="16dp" />

            <TextView
                android:id="@+id/tvCurrentSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
